# Copy to apps/web/.env.local; never commit actual secrets.
# Local preview; Vercel Production uses https://www.airbloom.app.
# Explicit public SITE_URL values must match that canonical origin.
SITE_URL=http://localhost:3000
# Local and preview builds are non-indexed demos.
# With no override, Vercel production deployments select production automatically.
NEXT_PUBLIC_SITE_MODE=demo
# Server-only, insert-only Supabase access. Never use a service-role key here.
SUPABASE_URL=https://nzxilhynyjdhtadkniml.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Optional URL-prefix ownership verification tokens. Domain properties use DNS.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
