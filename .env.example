# Copy to apps/web/.env.local; never commit actual secrets.
# Local default; on Vercel, omit to use its assigned production hostname,
# or set the final HTTPS domain explicitly.
SITE_URL=http://localhost:3000
# Keep demo until adoption claims, editorial content, and privacy details are reviewed.
# Production mode removes fictional social proof and permits indexing.
# With no override, Vercel production deployments select production automatically.
NEXT_PUBLIC_SITE_MODE=demo
# Server-only, insert-only Supabase access. Never use a service-role key here.
SUPABASE_URL=https://nzxilhynyjdhtadkniml.supabase.co
SUPABASE_PUBLISHABLE_KEY=
